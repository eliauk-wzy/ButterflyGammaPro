<Window x:Class="ButterflyGammaPro.Views.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭小蝴蝶滤镜"
        Height="270" Width="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="⚙️ 关闭窗口提示" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="请选择点击关闭按钮后的操作：" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="4,0,0,10">
                <RadioButton x:Name="RdoMinimize" IsChecked="True" GroupName="CloseAction" Cursor="Hand" Margin="0,0,0,10">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="最小化到系统托盘 (推荐)" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="后台静默运行，游戏内快捷键保持生效" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RdoExit" GroupName="CloseAction" Cursor="Hand">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="彻底退出程序" Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="关闭后台，屏幕色彩自动平滑还原为系统默认" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <CheckBox x:Name="ChkRemember" Grid.Row="2" Content="记住我的选择，以后不再提示" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,16" Cursor="Hand"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="82" Height="30" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,10,0" Click="BtnOk_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="取消" Width="72" Height="30" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" FontSize="12" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

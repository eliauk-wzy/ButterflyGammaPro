<Window x:Class="ButterflyGammaPro.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsdNotification"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border x:Name="MainContainer"
            Margin="20"
            Background="#E6181B22"
            BorderBrush="#40FFFFFF"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="22,12"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="-20"/>
        </Border.RenderTransform>
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="17" Background="#FF3B82F6" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🦋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTitle"
                               Text="【游戏内】室内/暗部 强力提亮"
                               Foreground="#F8FAFC"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <Border x:Name="BadgeKey" Background="#33FFFFFF" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtKey" Text="F8" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                
                <TextBlock x:Name="TxtDetails"
                           Text="Gamma: 2.20 | 亮度: -5% | 对比度: 135%"
                           Foreground="#94A3B8"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

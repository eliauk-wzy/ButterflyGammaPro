<Window x:Class="ButterflyGammaPro.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" MouseDown="Border_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="发现新版本" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Butterfly Gamma Pro" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <Button Content="✕" Width="30" Height="26" HorizontalAlignment="Right" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- 2. 版本对比横幅 -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前版本：" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentVer" Text="v1.0.0" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  ➜  最新版本：" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Border Background="#065F46" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRemoteVer" Text="v1.0.1" Foreground="#34D399" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtPublishDate" Text="2026-10-31" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. 更新日志内容 -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TxtReleaseNotes" Text="更新日志加载中..." Foreground="#CBD5E1" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 4. 下载进度区域 (初始隐藏) -->
            <StackPanel x:Name="PanelProgress" Grid.Row="3" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="正在下载新版本..." Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="PbDownload" Height="6" Minimum="0" Maximum="100" Value="0" Background="#334155" Foreground="#38BDF8" BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- 5. 底部操作按钮 -->
            <Grid Grid.Row="4">
                <Button Content="🌐 浏览器打开" Height="32" Width="98" HorizontalAlignment="Left" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" FontSize="12" Cursor="Hand" Click="BtnBrowser_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="稍后再说" Width="82" Height="32" Background="#1E293B" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontSize="12" Cursor="Hand" Margin="0,0,10,0" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnUpdateNow" Content="⚡ 立即自动更新" Width="120" Height="32" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnUpdateNow_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

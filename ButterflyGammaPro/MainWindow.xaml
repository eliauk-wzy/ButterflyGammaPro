<Window x:Class="ButterflyGammaPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Butterfly Gamma Pro (小蝴蝶滤镜)"
        Height="640" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app.ico"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题栏 -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="14,14,0,0" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="butterfly.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Butterfly Gamma Pro" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="小蝴蝶滤镜 Pro" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCheckUpdate" Content="🔄 检查更新" Width="82" Height="26" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#1E3A8A" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnCheckUpdate_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="一" Width="36" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="36" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 主内容区 -->
            <Grid Grid.Row="1" Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：方案列表 -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="🎯 滤镜方案" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="➕ 添加滤镜" HorizontalAlignment="Right" Width="80" Height="25" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnAddProfile_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,6">
                            <ItemsControl x:Name="ListProfiles">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderThickness="1.2" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand" MouseDown="ProfileItem_MouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Background" Value="#172554"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding KeyName, StringFormat='快捷键: {0}'}" Foreground="#94A3B8" FontSize="10.5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="4,2" Margin="0,0,6,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="生效中" Foreground="#38BDF8" FontSize="10"/>
                                                    </Border>
                                                    <Button Content="🗑️" Width="22" Height="22" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="11" Cursor="Hand" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" Click="BtnDeleteProfile_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Text="提示：支持 F1~F12 及鼠标侧键 (Mouse 4/5) 秒切" Foreground="#64748B" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- 右侧：方案详细参数 -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 0. 目标屏幕 (原生多显示器架构支持 & HDR 检测) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="🖥️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="目标屏幕" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbMonitors" Grid.Column="1" Height="26" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" FontSize="11" DisplayMemberPath="Title" SelectedValuePath="DisplayId" SelectionChanged="CmbMonitors_SelectionChanged"/>
                                <Button x:Name="BtnRefreshMonitors" Grid.Column="2" Content="🔄" Width="26" Height="26" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Margin="6,0,0,0" ToolTip="重新检测连接的物理显示器" Cursor="Hand" Click="BtnRefreshMonitors_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                            <Border x:Name="BadgeHdrWarning" Grid.Row="1" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,4,0,0" Visibility="Collapsed" Cursor="Hand" ToolTip="点击打开 Windows 显示设置调节 HDR" MouseDown="BadgeHdrWarning_MouseDown">
                                <TextBlock Text="⚠️ 目标屏幕处于 HDR/ACM 模式：系统接管色彩管道，建议竞技游戏切换为 SDR（点击打开系统设置）" Foreground="#FCA5A5" FontSize="10.5"/>
                            </Border>
                        </Grid>

                        <!-- 1. 基础配置：名称与快捷键 -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="滤镜方案名称" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtProfileName" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" FontSize="12" Padding="6,3" FontWeight="SemiBold" TextChanged="TxtProfileName_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="绑定快捷键 (支持鼠标侧键)" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbHotKey" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Height="26" FontSize="11" SelectionChanged="CmbHotKey_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2. 滑块调色区 (通道切换 + 暗部平衡 + 高光滚降 + RGB微调) -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <!-- RGB 通道切换与电竞快速预设 -->
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RdoChanAll" Content="⚪ 全RGB" IsChecked="True" Foreground="#38BDF8" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Checked="RdoChan_Checked"/>
                                    <RadioButton x:Name="RdoChanRed" Content="🔴 红" Foreground="#EF4444" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Checked="RdoChan_Checked"/>
                                    <RadioButton x:Name="RdoChanGreen" Content="🟢 绿" Foreground="#10B981" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Checked="RdoChan_Checked"/>
                                    <RadioButton x:Name="RdoChanBlue" Content="🔵 蓝" Foreground="#60A5FA" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Checked="RdoChan_Checked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="🌿 压制夜视仪绿光" Height="20" Padding="5,0" Background="#0F172A" Foreground="#10B981" BorderBrush="#065F46" BorderThickness="1" FontSize="10" Cursor="Hand" Margin="0,0,4,0" Click="BtnPresetNvg_Click"/>
                                    <Button Content="🔴 突出红衣敌人" Height="20" Padding="5,0" Background="#0F172A" Foreground="#EF4444" BorderBrush="#7F1D1D" BorderThickness="1" FontSize="10" Cursor="Hand" Click="BtnPresetRedEnemy_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- A. 暗部平衡 (Black Equalizer / 仅提亮暗部细节) -->
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="🌑 暗部平衡 (Black Equalizer / 仅提亮0%~25%暗角阴影)" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                        <TextBox x:Name="TxtBlackEqVal" Style="{StaticResource ValTextBox}" Width="40" Height="18" Text="20" TextChanged="TxtBlackEqVal_TextChanged" LostFocus="TxtBlackEqVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderBlackEq" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="20" ValueChanged="Slider_ValueChanged"/>

                            <!-- B. 高光防刺眼抑制 (Highlight Rolloff) -->
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="🛡️ 高光防刺眼抑制 (Highlight Rolloff / 压制雪盲与枪口火光)" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                        <TextBox x:Name="TxtHighlightVal" Style="{StaticResource ValTextBox}" Width="40" Height="18" Text="30" TextChanged="TxtHighlightVal_TextChanged" LostFocus="TxtHighlightVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderHighlight" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Value="30" ValueChanged="Slider_ValueChanged"/>

                            <!-- C. 灰度伽马 (Gamma) -->
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="灰度伽马 (Gamma / 整体曲率)" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                        <TextBox x:Name="TxtGammaVal" Style="{StaticResource ValTextBox}" Width="40" Height="18" Text="2.20" TextChanged="TxtGammaVal_TextChanged" LostFocus="TxtGammaVal_LostFocus"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderGamma" Style="{StaticResource ModernSlider}" Minimum="100" Maximum="320" Value="220" ValueChanged="Slider_ValueChanged"/>

                            <!-- D. 对比度 (Contrast) -->
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="画面对比度 (Contrast / 轮廓锐度)" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                        <TextBox x:Name="TxtContrastVal" Style="{StaticResource ValTextBox}" Width="40" Height="18" Text="135" TextChanged="TxtContrastVal_TextChanged" LostFocus="TxtContrastVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderContrast" Style="{StaticResource ModernSlider}" Minimum="80" Maximum="180" Value="135" ValueChanged="Slider_ValueChanged"/>

                            <!-- E. 亮度 (Brightness) -->
                            <Grid Margin="0,1,0,1">
                                <TextBlock Text="微调亮度 (Brightness)" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                        <TextBox x:Name="TxtBrightnessVal" Style="{StaticResource ValTextBox}" Width="40" Height="18" Text="-5" TextChanged="TxtBrightnessVal_TextChanged" LostFocus="TxtBrightnessVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderBrightness" Style="{StaticResource ModernSlider}" Minimum="-30" Maximum="30" Value="-5" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- 3. 全局开关 -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,8">
                            <CheckBox x:Name="ChkOsd" Content="按键浮窗提示" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkTransition" Content="120ms平滑过渡" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkAntiReset" Content="防切屏掉滤镜" Foreground="#94A3B8" FontSize="11" IsChecked="True"/>
                        </StackPanel>

                        <!-- 4. 操作按钮 -->
                        <Grid Grid.Row="4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🌟 立即应用" Width="105" Height="30" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="BtnApplyCurrent_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="🖥️ 恢复正常" Width="105" Height="30" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnResetDefault_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                            <Button Content="💾 保存配置" Width="85" Height="30" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#1E3A8A" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right" Click="BtnSaveConfig_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. 底部状态栏 -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,14,14" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="状态：就绪，快捷键已激活" Foreground="#94A3B8" FontSize="11.5"/>
                    </StackPanel>
                    <Button Content="后台静默运行" Width="95" Height="26" Background="#0F172A" Foreground="#94A3B8" BorderThickness="0" FontSize="11" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnMinimizeTray_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

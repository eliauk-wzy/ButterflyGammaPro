<Window x:Class="ButterflyGammaPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Butterfly Gamma Pro (小蝴蝶滤镜)"
        Height="580" Width="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app.ico"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <!-- 托盘右键沉浸式深色菜单样式 -->
        <ContextMenu x:Key="TrayMenu" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.2">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#F1F5F9"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Margin" Value="4,3"/>
                </Style>
            </ContextMenu.Resources>
        </ContextMenu>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题栏 -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="14,14,0,0" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="butterfly.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Butterfly Gamma Pro" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="小蝴蝶滤镜" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCheckUpdate" Content="🔄 检查更新" Width="82" Height="26" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#1E3A8A" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnCheckUpdate_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="一" Width="36" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="36" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 主内容区 -->
            <Grid Grid.Row="1" Margin="18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：方案列表 -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="🎯 滤镜方案" Foreground="#F1F5F9" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="➕ 添加滤镜" HorizontalAlignment="Right" Width="82" Height="26" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnAddProfile_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6">
                            <ItemsControl x:Name="ProfileList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Background="#0F172A" BorderThickness="1" CornerRadius="8" Padding="10,8" Cursor="Hand" MouseLeftButtonDown="ProfileCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Background" Value="#172554"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding KeyName, StringFormat='快捷键: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="4,2" Margin="0,0,6,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="生效中" Foreground="#38BDF8" FontSize="10"/>
                                                    </Border>
                                                    <Button Content="🗑️" Width="22" Height="22" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="11" Cursor="Hand" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" Click="BtnDeleteProfile_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Text="提示：点击左侧方案切换，点击右侧自由改名与微调" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- 右侧：方案详细参数 -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 基础配置 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="滤镜方案名称 (可点击直接修改)" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProfileName" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" FontSize="13" Padding="8,5" FontWeight="SemiBold" TextChanged="TxtProfileName_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="绑定快捷键" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbHotKey" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#334155" Height="30" SelectionChanged="CmbHotKey_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- 滑块调色区 (支持直接输入数字) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- 1. Gamma -->
                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="灰度伽马 (Gamma / 核心暗角提亮)" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="4,2">
                                        <TextBox x:Name="TxtGammaVal" Style="{StaticResource ValTextBox}" Width="46" Height="20" Text="2.20" TextChanged="TxtGammaVal_TextChanged" LostFocus="TxtGammaVal_LostFocus"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderGamma" Style="{StaticResource ModernSlider}" Minimum="100" Maximum="320" Value="220" ValueChanged="Slider_ValueChanged"/>

                            <!-- 2. 对比度 -->
                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="画面对比度 (Contrast / 突出轮廓)" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="4,2">
                                        <TextBox x:Name="TxtContrastVal" Style="{StaticResource ValTextBox}" Width="46" Height="20" Text="135" TextChanged="TxtContrastVal_TextChanged" LostFocus="TxtContrastVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderContrast" Style="{StaticResource ModernSlider}" Minimum="80" Maximum="180" Value="135" ValueChanged="Slider_ValueChanged"/>

                            <!-- 3. 亮度 -->
                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="高光微调 (Brightness / 压制防刺眼)" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="4,2">
                                        <TextBox x:Name="TxtBrightnessVal" Style="{StaticResource ValTextBox}" Width="46" Height="20" Text="-5" TextChanged="TxtBrightnessVal_TextChanged" LostFocus="TxtBrightnessVal_LostFocus"/>
                                    </Border>
                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="SliderBrightness" Style="{StaticResource ModernSlider}" Minimum="-30" Maximum="30" Value="-5" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>

                        <!-- 全局开关 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,12">
                            <CheckBox x:Name="ChkOsd" Content="游戏内按键浮窗提示" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkTransition" Content="120ms平滑过渡 (防晃眼)" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0" IsChecked="True"/>
                            <CheckBox x:Name="ChkAntiReset" Content="防切屏掉滤镜" Foreground="#94A3B8" FontSize="12" IsChecked="True"/>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🌟 立即应用此滤镜" Width="120" Height="32" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" Click="BtnApplyCurrent_Click"/>
                                <Button Content="🖥️ 恢复正常屏幕" Width="120" Height="32" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnResetDefault_Click"/>
                            </StackPanel>
                            <Button Content="💾 保存配置" Width="90" Height="32" Background="#0F172A" Foreground="#38BDF8" BorderBrush="#1E3A8A" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right" Click="BtnSaveConfig_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. 底部状态栏 -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,14,14" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="状态：就绪，快捷键已激活" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                    <Button Content="后台静默运行" Width="95" Height="28" Background="#0F172A" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnMinimizeTray_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
